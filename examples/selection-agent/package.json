{
  "name": "@typescript-agent-harness/example-selection-agent",
  "private": true,
  "version": "1.6.7",
  "type": "module",
  "scripts": {
    "start": "tah chat",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
