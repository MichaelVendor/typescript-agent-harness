{
  "name": "@typescript-agent-harness/desktop",
  "productName": "tah",
  "version": "1.4.1",
  "private": true,
  "description": "macOS app for tah serve",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "dist": "pnpm -w run build && pnpm run build && node scripts/fetch-node.mjs && node scripts/prepare-tah.mjs && rm -rf release && electron-builder --mac --arm64"
  },
  "config": {
    "node": "22.23.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "dev.tah.desktop",
    "directories": {
      "output": "release"
    },
    "files": ["dist/**/*", "welcome/**/*", "package.json", "!node_modules/**/*"],
    "extraResources": [
      { "from": "bundle/node", "to": "node", "filter": ["**/*"] },
      { "from": "bundle/tah", "to": "tah", "filter": ["**/*"] },
      { "from": "bundle/tah/node_modules", "to": "tah/node_modules", "filter": ["**/*"] }
    ],
    "npmRebuild": false,
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "tah-${version}-arm64.${ext}"
    }
  }
}
