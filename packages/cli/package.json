{
  "name": "@typescript-agent-harness/cli",
  "version": "0.22.3",
  "description": "typescript-agent-harness CLI (tah)",
  "type": "module",
  "bin": {
    "tah": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/cli.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@typescript-agent-harness/agent": "workspace:*",
    "@typescript-agent-harness/core": "workspace:*",
    "@typescript-agent-harness/llm": "workspace:*",
    "@typescript-agent-harness/mcp": "workspace:*",
    "@typescript-agent-harness/permissions": "workspace:*",
    "@typescript-agent-harness/scheduler": "workspace:*",
    "@typescript-agent-harness/storage": "workspace:*",
    "@typescript-agent-harness/tools": "workspace:*",
    "marked": "^12.0.2",
    "marked-terminal": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelVendor/typescript-agent-harness.git",
    "directory": "packages/cli"
  },
  "homepage": "https://MichaelVendor.github.io/typescript-agent-harness/",
  "bugs": {
    "url": "https://github.com/MichaelVendor/typescript-agent-harness/issues"
  }
}
