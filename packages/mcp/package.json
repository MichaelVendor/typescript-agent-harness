{
  "name": "@typescript-agent-harness/mcp",
  "version": "0.4.0",
  "description": "MCP tools adapted onto the Tool registry",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@typescript-agent-harness/core": "workspace:*",
    "@typescript-agent-harness/llm": "workspace:*",
    "@typescript-agent-harness/tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  }
}
